<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  A deliberately awkward little piece, for checking the importer. It is not music anybody
  would want to play; it is every case the parser has to get right, in eight measures:

    m1  two staves with different rhythms at once (half notes under quarters)
    m2  beamed eighths in the right hand over a dotted half in the left
    m3  a chord in each hand, and a written accidental
    m4  a tie held across the barline into m5
    m5  the tied note, plus rests of three kinds
    m6  two voices in the right hand, using backup
    m7  a clef change: the left hand goes up into the treble
    m8  back to the bass clef, and a whole note to finish
-->
<score-partwise version="3.1">
  <work><work-title>Import check</work-title></work>
  <identification>
    <creator type="composer">Nobody</creator>
  </identification>
  <part-list>
    <score-part id="P1"><part-name>Piano</part-name></score-part>
  </part-list>
  <part id="P1">

